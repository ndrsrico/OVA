{
  "version": 3,
  "overrides": {
    "Temario/index.html": {
      "path": "Temario"
    },
    "Evaluacion/index.html": {
      "path": "Evaluacion"
    },
    "Recursos/index.html": {
      "path": "Recursos"
    },
    "index.html": {
      "path": ""
    },
    "Welcome/index.html": {
      "path": "Welcome"
    },
    "Creditos/index.html": {
      "path": "Creditos"
    },
    "Actividades/index.html": {
      "path": "Actividades"
    },
    "introduccion/index.html": {
      "path": "introduccion"
    }
  },
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/Temario.bak",
      "dest": "/Temario.bak"
    },
    {
      "src": "/Temario-simple",
      "dest": "/Temario-simple"
    },
    {
      "src": "/Temario-NEW",
      "dest": "/Temario-NEW"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}